diff --git a/ircs-prod/core/05-application-network-policy.yaml b/ircs-prod/core/05-application-network-policy.yaml
new file mode 100644
index 0000000..9a19c16
--- /dev/null
+++ b/ircs-prod/core/05-application-network-policy.yaml
@@ -0,0 +1,123 @@
+# Restrict ingress only for IRCS application pods. Datastores, egress and other namespaces are unchanged.
+apiVersion: networking.k8s.io/v1
+kind: NetworkPolicy
+metadata:
+  name: ircs-application-ingress
+  namespace: ircs-prod
+  labels:
+    app.kubernetes.io/part-of: ircs
+  annotations:
+    argocd.argoproj.io/sync-wave: '-20'
+spec:
+  podSelector:
+    matchLabels:
+      app.kubernetes.io/part-of: ircs
+      ircs.prodigalgal.com/workload: application
+    matchExpressions:
+    - key: app
+      operator: NotIn
+      values: [ircs-api-gateway]
+  policyTypes: [Ingress]
+  ingress:
+  # Service-to-service /internal calls retain their token and scope checks.
+  # API paths additionally require the gateway's Ed25519 signature at the servlet boundary.
+  - from:
+    - podSelector:
+        matchLabels:
+          app.kubernetes.io/part-of: ircs
+          ircs.prodigalgal.com/workload: application
+    ports:
+    - {protocol: TCP, port: 8080}
+    - {protocol: TCP, port: 80}
+    - {protocol: TCP, port: 3000}
+  - from:
+    - namespaceSelector:
+        matchLabels:
+          kubernetes.io/metadata.name: monitoring
+      podSelector:
+        matchLabels:
+          app.kubernetes.io/name: prometheus
+    ports:
+    - {protocol: TCP, port: 8080}
+---
+# Only actual ingress proxies, portal SSR and Prometheus may reach the API gateway.
+apiVersion: networking.k8s.io/v1
+kind: NetworkPolicy
+metadata:
+  name: ircs-api-gateway-ingress
+  namespace: ircs-prod
+  labels:
+    app.kubernetes.io/part-of: ircs
+  annotations:
+    argocd.argoproj.io/sync-wave: '-20'
+spec:
+  podSelector:
+    matchLabels:
+      app: ircs-api-gateway
+      app.kubernetes.io/part-of: ircs
+  policyTypes: [Ingress]
+  ingress:
+  - from:
+    - podSelector:
+        matchLabels:
+          app.kubernetes.io/part-of: ircs
+        matchExpressions:
+        - key: app
+          operator: In
+          values: [ircs-portal-frontend, ircs-admin-frontend, ircs-frontend-gateway]
+    ports:
+    - {protocol: TCP, port: 8080}
+  - from:
+    - namespaceSelector:
+        matchLabels:
+          kubernetes.io/metadata.name: envoy-gateway-system
+      podSelector:
+        matchLabels:
+          app.kubernetes.io/name: envoy
+          gateway.envoyproxy.io/owning-gateway-name: mnnu-gateway
+          gateway.envoyproxy.io/owning-gateway-namespace: gateway-system
+    ports:
+    - {protocol: TCP, port: 8080}
+  - from:
+    - namespaceSelector:
+        matchLabels:
+          kubernetes.io/metadata.name: monitoring
+      podSelector:
+        matchLabels:
+          app.kubernetes.io/name: prometheus
+    ports:
+    - {protocol: TCP, port: 8080}
+---
+# Public /media is deliberately routed straight to storage; frontend pages also bypass the API gateway.
+apiVersion: networking.k8s.io/v1
+kind: NetworkPolicy
+metadata:
+  name: ircs-public-edge-ingress
+  namespace: ircs-prod
+  labels:
+    app.kubernetes.io/part-of: ircs
+  annotations:
+    argocd.argoproj.io/sync-wave: '-20'
+spec:
+  podSelector:
+    matchLabels:
+      app.kubernetes.io/part-of: ircs
+    matchExpressions:
+    - key: app
+      operator: In
+      values: [ircs-storage-service, ircs-admin-frontend, ircs-portal-frontend, ircs-frontend-gateway]
+  policyTypes: [Ingress]
+  ingress:
+  - from:
+    - namespaceSelector:
+        matchLabels:
+          kubernetes.io/metadata.name: envoy-gateway-system
+      podSelector:
+        matchLabels:
+          app.kubernetes.io/name: envoy
+          gateway.envoyproxy.io/owning-gateway-name: mnnu-gateway
+          gateway.envoyproxy.io/owning-gateway-namespace: gateway-system
+    ports:
+    - {protocol: TCP, port: 8080}
+    - {protocol: TCP, port: 80}
+    - {protocol: TCP, port: 3000}
